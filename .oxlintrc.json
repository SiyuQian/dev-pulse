{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "jsx-a11y", "vitest", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "ignorePatterns": ["dist", "public"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],

    // React 19 automatic JSX runtime — React is never in scope by design.
    "react/react-in-jsx-scope": "off",

    // `import './index.css'` is how Vite pulls stylesheets into the bundle.
    "import/no-unassigned-import": "off",

    // GraphQL cursor pagination is inherently sequential: each request needs the
    // previous response's endCursor, so Promise.all is not an option.
    "no-await-in-loop": "off",

    // The repo/account pickers are custom comboboxes. role="listbox"/"option" on
    // div/label is the correct ARIA pattern for them; a native <select> cannot do
    // multi-select with checkboxes and inline "add owner/name" entry.
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "off",

    // Focus moves into the search field when the user opens the picker, which is
    // the expected behaviour for a menu opened by explicit user action.
    "jsx-a11y/no-autofocus": "off",

    // Misfires on table cells whose text sits inside nested elements.
    "jsx-a11y/control-has-associated-label": "off"
  }
}
